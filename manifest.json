{
	"manifest_version": 3,
	"name": "XrmWebTools",
	"short_name": "XrmWebTools",
	"version": "2.0.25.423",
	"description": "Only for *.dynamics.com/*",
	"content_security_policy": {
		"script-src": "self",
		"object-src": "self"
	},
	"action": {
		"default_title": "XrmWebTools",
		"default_icon": "/img/XWT48.png",
		"default_popup": "popup/popup.html"

	},
	"icons": {
		"32": "img/XWT32.png",
		"48": "img/XWT48.png",
		"64": "img/XWT64.png",
		"128": "img/XWT128.png"
	},
	"content_scripts": [
		{
			"run_at": "document_end",
			"matches": [
				"*://*.dynamics.com/*"
			],
			"js": [
				"tools/init.js",
				"contextmenu/init.js"
			]
		}
	],
	"permissions": [
		"scripting",
		"activeTab",
		"declarativeNetRequest",
		"storage",
		"webRequest"
	],
	"host_permissions": [
		"*://*.dynamics.com/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"web_accessible_resources": [
		{
			"matches": [ "*://*.dynamics.com/*" ],
			"resources": [ "*" ]
		}
	]
}
